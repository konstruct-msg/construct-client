#!/bin/sh

set -e
cd "$(git rev-parse --show-toplevel)"

fail=0

printf '\n[pre-push] cargo fmt\n'
if ! cargo fmt --all -- --check; then
    fail=1
    printf '\n  чинится одной командой: cargo fmt --all\n'
fi


if [ "$fail" -eq 0 ] && [ "${SKIP_CLIPPY:-0}" != "1" ]; then
    printf '\n[pre-push] clippy -D warnings (SKIP_CLIPPY=1 чтобы пропустить)\n'
    cargo clippy --workspace --all-targets --all-features -- -D warnings || fail=1
fi

if [ "$fail" -ne 0 ]; then
    cat <<'EOF'

[pre-push] ОСТАНОВЛЕНО

EOF
    exit 1
fi

printf '\n[pre-push] ок\n\n'
